@using AnketOtomasyonu.Models.Entities
@model AnketOtomasyonu.Models.ViewModels.SurveyFillViewModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
<style>
/* ── Likert Slider ── */
.likert-wrapper {
    padding: 8px 0 4px;
}
.likert-slider-track {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
}
.likert-slider-track input[type=range] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(to right, #e53e3e, #ed8936, #f6c90e, #68d391, #38a169);
    outline: none;
    cursor: pointer;
    margin: 8px 0;
}
.likert-slider-track input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #6c63ff;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
    transition: border-color .2s, box-shadow .2s;
}
.likert-slider-track input[type=range]::-webkit-slider-thumb:hover {
    border-color: #4c46e0;
    box-shadow: 0 3px 12px rgba(108,99,255,.4);
}
.likert-slider-track input[type=range]::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #6c63ff;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
}
.likert-label-box {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
}
.likert-label-box span {
    font-size: 0.72rem;
    color: #666;
    text-align: center;
    flex: 1;
}
.likert-selected-label {
    text-align: center;
    margin-top: 10px;
    min-height: 28px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
}
.likert-selected-label .badge-likert {
    display: inline-block;
    padding: 5px 18px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    background: #f0edff;
    color: #6c63ff;
    border: 1px solid #d0c9ff;
    transition: all .2s;
}
</style>
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body text-center py-4"
                 style="background:linear-gradient(135deg,#3A3A3A,#2a2a2a);border-radius:8px 8px 0 0;color:#fff;">
                <h3 class="fw-bold mb-1">@Model.Title</h3>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mb-0 opacity-75">@Model.Description</p>
                }
            </div>
            @if (Model.IsAnonymous)
            {
                <div class="alert alert-info m-3 mb-0">
                    <i class="bi bi-shield-check me-2"></i>
                    Bu anket <strong>anonimdir</strong>. Kimlik bilgileriniz kaydedilmez.
                </div>
            }
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
        }

        @if (ViewData["IsCourseEval"] as bool? == true)
        {
            <div class="alert alert-primary m-3 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-book-half fs-5"></i>
                <div>
                    <strong>Değerlendirilen Ders:</strong>
                    @ViewData["CourseEvalDersNo"] — @ViewData["CourseEvalDersAdi"]
                    @if (ViewData["CourseEvalYil"] != null)
                    {
                        <span class="ms-2 text-muted">(@ViewData["CourseEvalYil"])</span>
                    }
                </div>
            </div>
        }

        <form asp-controller="SurveyResponse" asp-action="Submit" method="post" id="fillForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SurveyId" value="@Model.SurveyId" />

            @{
                var questions = Model.Questions.OrderBy(x => x.OrderIndex).ToList();
            }

            @for (int i = 0; i < questions.Count; i++)
            {
                var q = questions[i];
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            @(i + 1). @q.Text
                            @if (q.IsRequired)
                            {
                                <span class="text-danger">*</span>
                            }
                            else
                            {
                                <small class="text-muted fw-normal">(İsteğe bağlı)</small>
                            }
                        </h6>

                        <input type="hidden" name="Answers[@i].QuestionId" value="@q.QuestionId" />

                        @if (q.Type == QuestionType.Likert)
                        {
                            var opts = q.Options.OrderBy(x => x.OrderIndex).ToList();
                            var optCount = opts.Count;
                            var sliderMax = optCount - 1;
                            var midVal = sliderMax / 2;
                            // hidden radios (gönderim için)
                            foreach (var o in opts)
                            {
                                <input type="radio" class="d-none likert-radio"
                                       name="Answers[@i].SelectedOptionId"
                                       value="@o.Id"
                                       id="q@(q.QuestionId)_o@(o.Id)"
                                       data-required="@q.IsRequired.ToString().ToLower()" />
                            }
                            <div class="likert-wrapper">
                                <div class="likert-slider-track">
                                    <input type="range"
                                           id="slider_q@(q.QuestionId)"
                                           min="0" max="@sliderMax" step="1"
                                           value="@midVal"
                                           class="likert-range-input"
                                           data-qid="@q.QuestionId"
                                           data-opts="@string.Join(",", opts.Select(o => o.Id))"
                                           data-names="@string.Join("|", opts.Select(o => o.Text))"
                                           style="cursor:pointer;" />
                                </div>
                                <div class="likert-label-box">
                                    @foreach (var o in opts)
                                    {
                                        <span>@o.Text</span>
                                    }
                                </div>
                                <div class="likert-selected-label" id="lbl_q@(q.QuestionId)">
                                    <span class="text-muted small">Lütfen bir değer seçin</span>
                                </div>
                            </div>
                        }
                        else if (q.Type == QuestionType.MultipleChoice)
                        {
                            @foreach (var o in q.Options.OrderBy(x => x.OrderIndex))
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Answers[@i].SelectedOptionId"
                                           value="@o.Id"
                                           id="q@(q.QuestionId)_o@(o.Id)"
                                           data-required="@q.IsRequired.ToString().ToLower()" />
                                    <label class="form-check-label" for="q@(q.QuestionId)_o@(o.Id)">
                                        @o.Text
                                    </label>
                                </div>
                            }
                        }
                        else if (q.Type == QuestionType.OpenEnded)
                        {
                            <textarea name="Answers[@i].OpenEndedAnswer"
                              class="form-control"
                              rows="4"
                              placeholder="Cevabınızı yazınız..."
                              data-required="@q.IsRequired.ToString().ToLower()"></textarea>
                        }
                    </div>
                </div>
            }

            <!-- CAPTCHA -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">🔒 Güvenlik Doğrulaması</h6>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div id="captchaQuestion"
                             style="background:#3A3A3A;color:#F9BC00;font-size:20px;
                                    font-weight:800;padding:10px 24px;border-radius:10px;
                                    letter-spacing:2px;min-width:110px;text-align:center;">
                            ? + ?
                        </div>
                        <span style="font-size:20px;color:#999;font-weight:700;">=</span>
                        <input type="number"
                               id="captchaAnswer"
                               class="form-control"
                               style="max-width:90px;text-align:center;font-size:18px;font-weight:700;"
                               placeholder="?"
                               min="0" max="18"
                               autocomplete="off" />
                    </div>
                    <input type="hidden" id="captchaResult" />
                    <div id="captchaError"
                         class="text-danger small mt-2"
                         style="display:none;">
                        ❌ Hatalı cevap. Yeni soru üretildi.
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-5">
                <button type="submit" class="btn btn-su btn-lg" id="submitBtn">
                    <i class="bi bi-send me-1"></i>Anketi Gönder
                </button>
                @if (!Model.IsAnonymous)
                {
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">İptal</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var captchaCorrect = 0;

        function generateCaptcha() {
            var a = Math.floor(Math.random() * 9) + 1;
            var b = Math.floor(Math.random() * 9) + 1;
            captchaCorrect = a + b;
            document.getElementById('captchaQuestion').textContent = a + ' + ' + b;
            document.getElementById('captchaAnswer').value = '';
            document.getElementById('captchaError').style.display = 'none';
        }

        // ── Likert slider logic ──
        document.querySelectorAll('.likert-range-input').forEach(function(slider) {
            var qid = slider.dataset.qid;
            var optIds = slider.dataset.opts.split(',');
            var optNames = slider.dataset.names.split('|');
            var lblEl = document.getElementById('lbl_q' + qid);

            function updateSlider(idx) {
                var radio = document.getElementById('q' + qid + '_o' + optIds[idx]);
                if (radio) radio.checked = true;
                if (lblEl) {
                    lblEl.innerHTML = '<span class="badge-likert">' + optNames[idx] + '</span>';
                }
            }

            slider.addEventListener('input', function() { updateSlider(parseInt(this.value)); });
            slider.addEventListener('change', function() { updateSlider(parseInt(this.value)); });
        });

        generateCaptcha();

        document.getElementById('fillForm').addEventListener('submit', function (e) {

            // 1) Zorunlu radio kontrolü — * işaretli radio soruları cevaplanmalı
            var requiredGroups = {};
            document.querySelectorAll('input[type="radio"][data-required="true"]').forEach(function(el) {
                var groupName = el.name;
                if (typeof requiredGroups[groupName] === 'undefined') {
                    requiredGroups[groupName] = false;
                }
                if (el.checked) {
                    requiredGroups[groupName] = true;
                }
            });
            var missingRadio = false;
            for (var name in requiredGroups) {
                if (requiredGroups[name] === false) {
                    missingRadio = true;
                    break;
                }
            }
            if (missingRadio) {
                e.preventDefault();
                alert('Lütfen zorunlu (*) çoktan seçmeli/likert soruları işaretleyiniz.');
                return;
            }

            // 2) Zorunlu textarea kontrolü — * işaretli açık uçlu sorular cevaplanmalı
            var ok = true;
            document.querySelectorAll('textarea[data-required="true"]').forEach(function(el) {
                if (!el.value.trim()) {
                    e.preventDefault();
                    el.style.borderColor = '#dc3545';
                    if (ok) el.focus(); // Sadece ilk boşluğa odaklansın
                    alert('Lütfen zorunlu (*) açık uçlu soruları doldurunuz.');
                    ok = false;
                } else {
                    el.style.borderColor = ''; // Hatayı temizle
                }
            });
            if (!ok) return;

            // 3) Captcha kontrolü
            var userAns = parseInt(document.getElementById('captchaAnswer').value);
            if (isNaN(userAns) || userAns !== captchaCorrect) {
                e.preventDefault();
                document.getElementById('captchaError').textContent = '❌ Hatalı cevap. Yeni soru üretildi.';
                document.getElementById('captchaError').style.display = 'block';
                generateCaptcha();
                document.getElementById('captchaAnswer').focus();
                return;
            }

            // Doğru — submit
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass me-1"></i>Gönderiliyor...';
        });
    </script>
}
