@using AnketOtomasyonu.Models.Entities
@model Survey
@{
    ViewData["Title"] = "Anket Önizleme";
}

@section Styles {
<style>
.preview-hero {
    background: linear-gradient(135deg, #0f3460 0%, #0d6efd 100%);
    border-radius: 16px; color: #fff;
    padding: 32px 36px 28px; margin-bottom: 28px;
    box-shadow: 0 8px 32px rgba(13,110,253,.22);
}
.preview-hero h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 6px; }
.preview-hero .meta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.meta-pill {
    background: rgba(255,255,255,.18); border-radius: 20px;
    padding: 4px 14px; font-size: 0.78rem;
    display: flex; align-items: center; gap: 5px;
}
.q-card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.07); margin-bottom: 16px; }
.q-card:hover { box-shadow: 0 5px 18px rgba(0,0,0,.12); }
.q-number {
    width: 32px; height: 32px; background: #0d6efd; color: #fff;
    border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-size: .85rem; font-weight: 700; flex-shrink: 0;
}
.q-type-badge {
    font-size: .68rem; padding: 2px 10px; border-radius: 10px;
    border: 1px solid #cfe2ff; color: #0d6efd; background: #f0f6ff;
}
.likert-range-preview {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 12px; border-radius: 6px;
    background: linear-gradient(to right,#e53e3e,#ed8936,#f6c90e,#68d391,#38a169);
    outline: none; margin: 8px 0; pointer-events: none;
}
.likert-range-preview::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 26px; height: 26px; border-radius: 50%;
    background: #fff; border: 3px solid #0d6efd;
    box-shadow: 0 2px 8px rgba(0,0,0,.2);
}
.likert-label-row { display: flex; justify-content: space-between; max-width: 520px; margin: 6px auto 0; }
.likert-label-row span { font-size: .71rem; color: #777; text-align: center; flex: 1; }
.mc-option {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border: 1.5px solid #e9ecef;
    border-radius: 10px; margin-bottom: 8px; background: #fafafa; font-size: .9rem;
}
.mc-dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #0d6efd; background: #fff; flex-shrink: 0; }
.open-ended-box {
    border: 1.5px dashed #bdd5fe; border-radius: 10px;
    padding: 14px 16px; background: #f0f6ff;
    color: #9ca3af; font-style: italic; min-height: 70px; font-size: .88rem;
}
</style>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-eye me-2" style="color:#0d6efd;"></i>Anket Önizleme</h4>
    @if (User.HasSuperAdminAccess())
    {
        <a asp-controller="SuperAdmin" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Panele Dön
        </a>
    }
    else
    {
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Panele Dön
        </a>
    }
</div>

<!-- Hero -->
<div class="preview-hero">
    <h2>@Model.Title</h2>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="mb-0 opacity-75" style="font-size:.95rem;">@Model.Description</p>
    }
    <div class="meta-row">
        <span class="meta-pill"><i class="bi bi-person-fill"></i> @Model.CreatedByName</span>
        <span class="meta-pill"><i class="bi bi-building"></i> @Model.CreatedByBirim</span>
        <span class="meta-pill">
            <i class="bi bi-activity"></i>
            <span class="badge bg-light text-dark" style="font-size:.72rem;">@Model.Status</span>
            <span class="badge bg-info text-dark" style="font-size:.72rem;">@Model.ApprovalStatus</span>
        </span>
        <span class="meta-pill">
            <i class="bi bi-@(Model.IsAnonymous ? "shield-check" : "lock")"></i>
            @(Model.IsAnonymous ? "Anonim" : "Giriş Gerekli")
        </span>
        @if (!string.IsNullOrEmpty(Model.TargetFaculties))
        {
            <span class="meta-pill"><i class="bi bi-geo-alt-fill"></i> @Model.TargetFaculties</span>
        }
        <span class="meta-pill"><i class="bi bi-list-ol"></i> @Model.Questions.Count Soru</span>
    </div>
</div>

<!-- Sorular -->
<div class="mb-2 ps-1 text-muted small fw-semibold text-uppercase" style="letter-spacing:.8px;">
    <i class="bi bi-list-check me-1"></i>Sorular (@Model.Questions.Count)
</div>

@foreach (var q in Model.Questions.OrderBy(x => x.OrderIndex))
{
    <div class="q-card card">
        <div class="card-body px-4 py-3">
            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="q-number">@q.OrderIndex</div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                        <span class="fw-semibold" style="font-size:.97rem; color:#1e293b;">
                            @q.Text
                            @if (q.IsRequired) { <span class="text-danger ms-1">*</span> }
                        </span>
                        <span class="q-type-badge">
                            @(q.Type == QuestionType.Likert ? "Likert" :
                              q.Type == QuestionType.MultipleChoice ? "Çoktan Seçmeli" : "Açık Uçlu")
                        </span>
                    </div>
                </div>
            </div>

            @if (q.Type == QuestionType.Likert)
            {
                var opts = q.Options.OrderBy(x => x.OrderIndex).ToList();
                var midVal = (opts.Count - 1) / 2;
                <div class="ps-5">
                    <div style="max-width:520px; margin:0 auto;">
                        <input type="range" class="likert-range-preview"
                               min="0" max="@(opts.Count - 1)" step="1" value="@midVal" />
                    </div>
                    <div class="likert-label-row">
                        @foreach (var o in opts) { <span>@o.Text</span> }
                    </div>
                    <div class="text-center mt-2">
                        <span class="text-muted small fst-italic">Lütfen bir değer seçin</span>
                    </div>
                </div>
            }
            else if (q.Type == QuestionType.MultipleChoice)
            {
                <div class="ps-5">
                    @foreach (var opt in q.Options.OrderBy(o => o.OrderIndex))
                    {
                        <div class="mc-option">
                            <div class="mc-dot"></div>
                            <span>@opt.Text</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ps-5">
                    <div class="open-ended-box">Kullanıcı buraya cevabını yazacak...</div>
                </div>
            }
        </div>
    </div>
}
