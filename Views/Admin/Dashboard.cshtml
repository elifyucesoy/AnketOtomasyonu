@using AnketOtomasyonu.Authorization
@using AnketOtomasyonu.Models.ViewModels
@using AnketOtomasyonu.Models.Entities
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
    var isSuperAdmin = User.HasSuperAdminAccess();

    // Stat card URL yardımcısı
    string CardUrl(string? sf) {
        return Url.Action("Dashboard", "Admin", new {
            birim      = Model.SelectedBirim ?? "",
            statusFilter = sf,
            startDate  = Model.StartDateStr,
            endDate    = Model.EndDateStr,
            dateSort   = Model.DateSort,
            page       = 1
        })!;
    }

    var activeLabel = Model.StatusFilter switch {
        "active"   => "Aktif",
        "draft"    => "Taslak",
        "passive"  => "Pasif",
        "pending"  => "Onay Bekleyen",
        "rejected" => "Reddedilen",
        _          => null
    };
}

@section Styles {
<style>
    .stat-card {
        cursor: pointer;
        border-radius: 12px;
        transition: transform .15s, box-shadow .15s;
        position: relative;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(37,99,235,.15) !important; }
    .border-ad { border: 2px solid #2563eb !important; }

    /* Tablo */
    .sa-col-actions { width: 200px; }
    .table > :not(caption) > * > * { vertical-align: middle; }
</style>
}

<!-- ── BAŞLIK ── -->
<div class="d-flex justify-content-between align-items-start align-items-sm-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-speedometer2 me-2" style="color:#2563eb;"></i>Yönetim Paneli</h2>
        @if (!string.IsNullOrEmpty(Model.SelectedBirim))
        {
            <small class="text-muted">Aktif Birim: <strong style="color:#2563eb;">@Model.SelectedBirim</strong></small>
        }
        else
        {
            <small class="text-muted">Biriminize ait anketleri görüntüleyin ve yönetin</small>
        }
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-eye me-1"></i>Anket Sayfası
        </a>
        <a asp-action="CreateSurvey" class="btn btn-sm fw-bold" style="background:#2563eb;color:#fff;">
            <i class="bi bi-plus-circle me-1"></i>Yeni Anket
        </a>
    </div>
</div>

<!-- ── ALERTS ── -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── İSTATİSTİK KARTLARI ── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == null ? "border-ad" : "border-0 shadow-sm")">
            <i class="bi bi-clipboard2-data" style="font-size:1.8rem;color:#2563eb;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.TotalSurveys</h3>
            <p class="text-muted small mb-0">Toplam Anket</p>
            <a href="@CardUrl(null)" class="stretched-link" title="Tümünü Göster"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "active" ? "border-success border-2" : "border-0 shadow-sm")">
            <i class="bi bi-check-circle text-success" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.ActiveSurveys</h3>
            <p class="text-muted small mb-0">Aktif</p>
            <a href="@CardUrl("active")" class="stretched-link" title="Aktif Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "draft" ? "border-warning border-2" : "border-0 shadow-sm")">
            <i class="bi bi-pencil-square text-warning" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.DraftSurveys</h3>
            <p class="text-muted small mb-0">Taslak</p>
            <a href="@CardUrl("draft")" class="stretched-link" title="Taslak Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "passive" ? "border-secondary border-2" : "border-0 shadow-sm")">
            <i class="bi bi-pause-circle text-secondary" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.PassiveSurveys</h3>
            <p class="text-muted small mb-0">Pasif</p>
            <a href="@CardUrl("passive")" class="stretched-link" title="Pasif Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "pending" ? "border-danger border-2" : "border-0 shadow-sm")">
            <i class="bi bi-hourglass-split text-danger" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.PendingApprovalCount</h3>
            <p class="text-muted small mb-0">Onay Bekleyen</p>
            <a href="@CardUrl("pending")" class="stretched-link" title="Onay Bekleyen"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "rejected" ? "border-secondary border-2" : "border-0 shadow-sm")">
            <i class="bi bi-x-circle text-secondary" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.RejectedCount</h3>
            <p class="text-muted small mb-0">Reddedilen</p>
            <a href="@CardUrl("rejected")" class="stretched-link" title="Reddedilen"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 border-0 shadow-sm">
            <i class="bi bi-chat-square-text text-info" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.TotalResponses</h3>
            <p class="text-muted small mb-0">Yanıt</p>
        </div>
    </div>
</div>

<!-- ── FİLTRE FORMU ── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Dashboard" id="dashFilterForm" class="d-flex gap-2 align-items-center flex-wrap">
            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />

            @if (Model.AuthorizedUnits.Count > 1)
            {
                <label class="fw-semibold mb-0" style="white-space:nowrap;"><i class="bi bi-funnel me-1"></i>Birim:</label>
                <select name="birim" class="form-select form-select-sm" style="min-width:200px;max-width:300px;">
                    <option value="">Tüm birimler</option>
                    @foreach (var u in Model.AuthorizedUnits)
                    {
                        <option value="@u" selected="@(Model.SelectedBirim == u ? "selected" : null)">@u</option>
                    }
                </select>
            }
            else
            {
                <input type="hidden" name="birim" value="@(Model.SelectedBirim ?? "")" />
            }

            <label class="fw-semibold mb-0 ms-1" style="white-space:nowrap;"><i class="bi bi-calendar3 me-1"></i>Tarih:</label>
            <input type="date" name="startDate" class="form-control form-control-sm" style="width:145px;"
                   value="@Model.StartDateStr" />
            <span class="text-muted">—</span>
            <input type="date" name="endDate" class="form-control form-control-sm" style="width:145px;"
                   value="@Model.EndDateStr" />

            <div class="btn-group btn-group-sm ms-1" role="group" title="Tarih sırası">
                <button type="submit" name="dateSort" value="newest"
                        class="btn @(Model.DateSort != "oldest" ? "btn-secondary" : "btn-outline-secondary")"
                        title="En yeniden → en eskiye">
                    <i class="bi bi-sort-down"></i>
                </button>
                <button type="submit" name="dateSort" value="oldest"
                        class="btn @(Model.DateSort == "oldest" ? "btn-secondary" : "btn-outline-secondary")"
                        title="En eskiden → en yeniye">
                    <i class="bi bi-sort-up"></i>
                </button>
            </div>

            <button type="submit" class="btn btn-sm fw-bold" style="background:#2563eb;color:#fff;">
                <i class="bi bi-search me-1"></i>Filtrele
            </button>

            @if (!string.IsNullOrEmpty(Model.SelectedBirim) || !string.IsNullOrEmpty(Model.StatusFilter)
                 || !string.IsNullOrEmpty(Model.StartDateStr) || !string.IsNullOrEmpty(Model.EndDateStr))
            {
                <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Temizle
                </a>
            }
        </form>

        @if (!string.IsNullOrEmpty(activeLabel))
        {
            <div class="mt-2">
                <span class="badge text-bg-light border fs-6 fw-normal">
                    <i class="bi bi-filter me-1"></i>@activeLabel filtresi aktif
                </span>
            </div>
        }
    </div>
</div>

<!-- ── ANKET LİSTESİ ── -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>Anketler
            @if (!string.IsNullOrEmpty(Model.SelectedBirim))
            {
                <span class="badge ms-2" style="background:#2563eb !important;">@Model.SelectedBirim</span>
            }
            else
            {
                <span class="badge ms-2 text-bg-light border">Tüm birimler</span>
            }
            @if (!string.IsNullOrEmpty(activeLabel))
            {
                <span class="badge bg-secondary ms-1">@activeLabel</span>
            }
        </h5>
        <span class="text-muted small">
            @Model.TotalCount kayıt
            @if (Model.TotalPages > 1)
            {
                <span> · Sayfa @Model.CurrentPage / @Model.TotalPages</span>
            }
        </span>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentSurveys.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Anket Adı</th>
                            <th>Durum</th>
                            <th>Tür</th>
                            <th>Onay</th>
                            <th>Soru</th>
                            <th>Yanıt</th>
                            <th>Tarih</th>
                            <th class="sa-col-actions text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSurveys)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @s.Title
                                    @if (!s.IsCreatedByCurrentUser)
                                    {
                                        <br /><small class="text-muted fw-normal">Siz oluşturmadınız — yalnızca görüntüleme ve sonuçlar</small>
                                    }
                                </td>
                                <td><span class="badge @s.StatusBadgeClass">@s.Status</span></td>
                                <td>
                                    @if (s.IsAnonymous)
                                    {
                                        <span class="badge bg-info">Anonim</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Giriş Gerekli</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @s.ApprovalBadgeClass" title="@s.ApprovalNote">@s.ApprovalLabel</span>
                                    @if (!isSuperAdmin && s.ApprovalStatus == ApprovalStatus.Rejected && !string.IsNullOrEmpty(s.ApprovalNote))
                                    {
                                        <button type="button"
                                                class="btn btn-link p-0 ms-1 text-danger rejection-note-btn"
                                                data-bs-toggle="popover"
                                                data-bs-placement="left"
                                                data-bs-trigger="focus"
                                                data-bs-title="Ret Sebebi"
                                                data-bs-content="@s.ApprovalNote"
                                                title="Ret sebebini gör">
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                        </button>
                                    }
                                </td>
                                <td>@s.QuestionCount</td>
                                <td>@s.ResponseCount</td>
                                <td class="text-muted small">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">

                                        <!-- ÖNİZLE -->
                                        <a asp-action="PreviewSurvey" asp-route-id="@s.Id"
                                           class="btn btn-sm btn-outline-primary" title="Önizle">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- ANKET URL KOPYALA (yalnız oluşturan) -->
                                        @if (s.IsCreatedByCurrentUser && s.Status == "Aktif")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    title="Anket Linkini Kopyala"
                                                    onclick="copySurveyLink(@s.Id, @s.IsAnonymous.ToString().ToLower(), this)">
                                                <i class="bi bi-link-45deg"></i>
                                            </button>
                                        }

                                        <!-- DÜZENLE -->
                                        @if (s.IsCreatedByCurrentUser)
                                        {
                                            <a asp-action="EditSurvey" asp-route-id="@s.Id"
                                               class="btn btn-sm btn-outline-primary" title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        <!-- SONUÇLAR (aynı birim — herkes görebilir) -->
                                        <a asp-action="Results" asp-route-id="@s.Id"
                                           class="btn btn-sm btn-outline-info" title="Sonuçlar">
                                            <i class="bi bi-bar-chart"></i>
                                        </a>

                                        <!-- YAYINLA / TEKRAR YAYINLA — yalnız oluşturan -->
                                        @if (s.IsCreatedByCurrentUser && (s.Status == "Taslak" || s.Status == "Pasif"))
                                        {
                                            @if (isSuperAdmin || s.ApprovalStatus == ApprovalStatus.Approved)
                                            {
                                                <form asp-action="Publish" asp-route-id="@s.Id" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Yayınla"
                                                            onclick="return confirm('Anket yayınlansın mı?')">
                                                        <i class="bi bi-broadcast"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (s.ApprovalStatus == ApprovalStatus.Rejected)
                                            {
                                                <span class="btn btn-sm btn-danger" title="@("Reddedildi: " + (s.ApprovalNote ?? ""))">
                                                    <i class="bi bi-x-circle"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="btn btn-sm btn-outline-warning"
                                                      title="Anket SuperAdmin onay kuyruğuna gönderildi">
                                                    <i class="bi bi-hourglass-split"></i>
                                                </span>
                                            }
                                        }

                                        @if (s.IsCreatedByCurrentUser && s.Status == "Kapalı")
                                        {
                                            @if (isSuperAdmin || s.ApprovalStatus == ApprovalStatus.Approved)
                                            {
                                                <form asp-action="Republish" asp-route-id="@s.Id" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Tekrar Yayınla"
                                                            onclick="return confirm('Anket tekrar yayınlansın mı?')">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </form>
                                            }
                                        }

                                        <!-- KAPAT -->
                                        @if (s.IsCreatedByCurrentUser && s.Status == "Aktif")
                                        {
                                            <form asp-action="Close" asp-route-id="@s.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-warning" title="Kapat"
                                                        onclick="return confirm('Anket kapatılsın mı?')">
                                                    <i class="bi bi-stop-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- SİL -->
                                        @if (s.IsCreatedByCurrentUser)
                                        {
                                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil"
                                                        onclick="return confirm('Anket silinsin mi? Bu işlem geri alınamaz!')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── SAYFALAMA ── -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center py-3">
                    <nav>
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Dashboard", "Admin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = Model.CurrentPage - 1 })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link @(p == Model.CurrentPage ? "" : "")"
                                       style="@(p == Model.CurrentPage ? "background:#2563eb;border-color:#2563eb;" : "")"
                                       href="@Url.Action("Dashboard", "Admin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = p })">@p</a>
                                </li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Dashboard", "Admin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = Model.CurrentPage + 1 })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2">
                    @if (!string.IsNullOrEmpty(activeLabel) || !string.IsNullOrEmpty(Model.StartDateStr) || !string.IsNullOrEmpty(Model.EndDateStr))
                    {
                        <span>Bu filtreye uygun anket bulunamadı.</span>
                    }
                    else
                    {
                        <span>Henüz anket yok.</span>
                    }
                </p>
                <a asp-action="CreateSurvey" class="btn btn-sm fw-bold mt-2" style="background:#2563eb;color:#fff;">
                    <i class="bi bi-plus-circle me-1"></i>İlk Anketi Oluştur
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.rejection-note-btn').forEach(function(el) {
        new bootstrap.Popover(el, { html: false });
    });

    function copySurveyLink(surveyId, isAnonymous, btn) {
        var url = window.location.origin + '/SurveyResponse/Fill/' + surveyId;
        var label = isAnonymous ? 'Anonim anket linki:' : 'Anket linki (login gerekli):';
        navigator.clipboard.writeText(url).then(function () {
            var orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg"></i>';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
            setTimeout(function () {
                btn.innerHTML = orig;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 1500);
        }).catch(function () { prompt(label, url); });
    }
</script>
}
