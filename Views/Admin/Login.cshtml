@using AnketOtomasyonu.Models.ViewModels
@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Girişi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: #2c2c2c;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .login-card {
            background: #fff;
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }

        .login-title {
            color: #3A3A3A;
            font-weight: 700;
            text-align: center;
            margin-bottom: 8px;
        }

        .login-sub {
            color: #888;
            text-align: center;
            margin-bottom: 28px;
            font-size: 14px;
        }

        .btn-admin {
            background: #3A3A3A;
            color: #F9BC00;
            font-weight: 600;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
        }

            .btn-admin:hover {
                background: #222;
                color: #F9BC00;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <h3 class="login-title">Admin Paneli</h3>
        <p class="login-sub">Yönetici girişi yapınız</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Admin" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold">Kullanıcı Adı</label>
                <input asp-for="Username" class="form-control" placeholder="Kullanıcı adınızı girin" autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Şifre</label>
                <div style="position:relative;">
                    <input asp-for="Password" type="password" class="form-control" id="adminPwd"
                           placeholder="Şifrenizi girin" style="padding-right:42px;" />
                    <button type="button" id="toggleAdminPwd"
                            style="position:absolute;right:10px;top:50%;transform:translateY(-50%);
                                   background:none;border:none;cursor:pointer;color:#888;padding:0;">
                        <i class="bi bi-eye" id="adminEyeIcon"></i>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn btn-admin">Giriş Yap</button>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('toggleAdminPwd').addEventListener('click', function() {
            var f = document.getElementById('adminPwd');
            var i = document.getElementById('adminEyeIcon');
            if (f.type === 'password') { f.type = 'text'; i.className = 'bi bi-eye-slash'; }
            else { f.type = 'password'; i.className = 'bi bi-eye'; }
        });
    </script>
</body>
</html>
