@using AnketOtomasyonu.Models.ViewModels
@model SurveyIndexViewModel
@{
    ViewData["Title"] = "Anketler";
}

@section Styles {
<style>
    /* ── Sayfa arka planı: lacivert ── */
    body { background: #1B2A4A !important; }
    .footer-su { background: #111e33 !important; }

    /* ── Container padding sıfırla ── */
    .container.py-4 { padding-top: 0 !important; }

    /* ── Hero bölümü ── */
    .su-hero {
        text-align: center;
        padding: 56px 20px 44px;
        color: #fff;
    }

    .su-hero-icon {
        width: 90px;
        height: 90px;
        background: var(--su-yellow);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 28px;
        font-size: 46px;
        color: #1B2A4A;
        box-shadow: 0 6px 24px rgba(249,188,0,.35);
    }

    .su-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .su-hero-sub {
        color: var(--su-yellow);
        font-size: 0.82rem;
        letter-spacing: 5px;
        font-weight: 700;
        text-transform: uppercase;
    }

    /* ── Anket Kartları ── */
    .survey-cards-section { padding-bottom: 64px; }

    .survey-card {
        background: #fff;
        border-radius: 16px;
        padding: 22px 18px 18px;
        text-align: center;
        box-shadow: 0 4px 18px rgba(0,0,0,.16);
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform .2s, box-shadow .2s;
    }

    .survey-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,.22);
    }

    .survey-card-icon {
        width: 60px;
        height: 60px;
        background: var(--su-yellow);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 26px;
        color: #1B2A4A;
    }

    .survey-card-title {
        font-size: 0.98rem;
        font-weight: 700;
        color: #1B2A4A;
        margin-bottom: 6px;
        line-height: 1.35;
        word-break: break-word;
        overflow-wrap: break-word;
        white-space: normal;
    }

    .survey-card-desc {
        font-size: 0.82rem;
        color: #888;
        margin-bottom: 10px;
        line-height: 1.5;
        /* Açıklama varsa max 2 satır göster */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .survey-card-meta {
        font-size: 0.75rem;
        color: #aaa;
        margin-bottom: 10px;
    }

    /* ── Ankete Başla butonu ── */
    .btn-ankete {
        background: var(--su-yellow);
        color: #1B2A4A;
        font-weight: 700;
        border: none;
        border-radius: 30px;
        padding: 11px 26px;
        font-size: 0.92rem;
        text-decoration: none;
        display: inline-block;
        transition: background .2s, transform .15s;
        width: 100%;
    }

    .btn-ankete:hover {
        background: #e0ab00;
        color: #1B2A4A;
        transform: scale(1.03);
    }

    .btn-ankete-disabled {
        background: #ddd;
        color: #999;
        border-radius: 30px;
        padding: 11px 26px;
        font-size: 0.92rem;
        width: 100%;
        display: inline-block;
        cursor: not-allowed;
    }

    /* ── Login badge ── */
    .login-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        color: #aaa;
        margin-bottom: 10px;
    }

    /* ── Boş durum ── */
    .empty-state {
        text-align: center;
        color: rgba(255,255,255,.55);
        padding: 80px 20px;
    }
</style>
}

<!-- ── HERO ── -->
<div class="su-hero">
    <div class="su-hero-icon">
        <i class="bi bi-mortarboard-fill"></i>
    </div>
    <h1>Selçuk Üniversitesi</h1>
    <p class="su-hero-sub">Anket Formları</p>
</div>

<!-- ── ALERTS ── -->
@if (TempData["Error"] != null)
{
    <div class="container mb-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="container mb-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- ── KARTLAR ── -->
@{
    var iconList = new[]
    {
        "bi-building",
        "bi-bar-chart-fill",
        "bi-bank2",
        "bi-mortarboard-fill",
        "bi-people-fill",
        "bi-clipboard2-data-fill",
        "bi-briefcase-fill",
        "bi-star-fill"
    };
}

@if (!Model.Surveys.Any())
{
    <div class="empty-state">
        <i class="bi bi-clipboard-x" style="font-size:3.5rem;"></i>
        <p class="mt-3 fs-5">Henüz aktif anket bulunmuyor.</p>
    </div>
}
else
{
    <div class="container survey-cards-section">
        <div class="row g-4 justify-content-center">
            @foreach (var survey in Model.Surveys)
            {
                var icon = iconList[survey.Id % iconList.Length];
                <div class="col-sm-6 col-lg-3">
                    <div class="survey-card">

                        <div class="survey-card-icon">
                            <i class="bi @icon"></i>
                        </div>

                        <div class="survey-card-title">@survey.Title</div>

                        @if (!string.IsNullOrEmpty(survey.Description))
                        {
                            <div class="survey-card-desc">@survey.Description</div>
                        }

                        <div class="login-badge">
                            @if (survey.IsAnonymous)
                            {
                                <i class="bi bi-shield-check text-success"></i>
                                <span class="text-success">Anonim</span>
                            }
                            else
                            {
                                <i class="bi bi-lock"></i>
                                <span>Giriş Gerekli</span>
                            }
                        </div>

                        @if (survey.TargetUnits.Count > 0)
                        {
                            <div class="w-100 mb-2 px-1">
                                <div class="small fw-semibold text-muted mb-1" style="font-size:0.7rem;">
                                    <i class="bi bi-bullseye me-1"></i>Hedef birimler
                                </div>
                                <div class="d-flex flex-wrap gap-1 justify-content-center">
                                    @if (survey.TargetUnits.Count >= 20)
                                    {
                                        <span class="badge rounded-pill bg-white text-dark border shadow-sm" style="font-size:0.62rem;">Tüm birimler</span>
                                    }
                                    else
                                    {
                                        @foreach (var u in survey.TargetUnits.Take(3))
                                        {
                                            <span class="badge rounded-pill bg-white text-dark border shadow-sm" style="font-size:0.62rem;max-width:100%;text-overflow:ellipsis;overflow:hidden;">@u</span>
                                        }
                                        @if (survey.TargetUnits.Count > 3)
                                        {
                                            <span class="small text-muted align-self-center" style="font-size:0.65rem;">+@(survey.TargetUnits.Count - 3)</span>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        @if (survey.Status == "Aktif")
                        {
                            @* Ders Değerlendirme (SurveyType=CourseEvaluation) → OBIS kimlik doğrulama akışı *@
                            @if (survey.SurveyType == AnketOtomasyonu.Models.Entities.SurveyType.CourseEvaluation)
                            {
                                <a asp-controller="CourseEvaluation"
                                   asp-action="CourseEvalLogin"
                                   asp-route-id="@survey.Id"
                                   class="btn-ankete mb-2">
                                    Ankete Katıl &rarr;
                                </a>
                            }
                            else
                            {
                                <a asp-controller="SurveyResponse"
                                   asp-action="Fill"
                                   asp-route-id="@survey.Id"
                                   class="btn-ankete mb-2">
                                    Ankete Başla &rarr;
                                </a>
                            }
                        }
                        
                        @if (Model.CanUseStaffSurveyTools)
                        {
                            var controller = Model.PreferSuperAdminSurveyLinks ? "SuperAdmin" : "Admin";
                            <a asp-controller="@controller" asp-action="PreviewSurvey" asp-route-id="@survey.Id" class="btn btn-sm btn-outline-info w-100 mb-1">
                                <i class="bi bi-eye"></i> Anketi Önizle
                            </a>
                        }

                        @if (survey.Status == "Taslak")
                        {
                            <span class="badge bg-warning text-dark mb-2">Taslak (Yayında Değil)</span>
                            @if (Model.CanUseStaffSurveyTools)
                            {
                                <a asp-controller="Admin" asp-action="EditSurvey" asp-route-id="@survey.Id" class="btn btn-sm btn-outline-secondary w-100">
                                    Düzenle
                                </a>
                            }
                        }
                        else if (survey.Status != "Aktif")
                        {
                            <span class="btn-ankete-disabled mb-2">@survey.Status</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
