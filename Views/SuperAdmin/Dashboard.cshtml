@using AnketOtomasyonu.Models.Entities
@using AnketOtomasyonu.Models.ViewModels
@model SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "SuperAdmin Dashboard";

    // Helper: stat card URL (tarih/sıralama parametrelerini korur)
    string CardUrl(string? sf) {
        var b = Model.SelectedBirim ?? "";
        return Url.Action("Dashboard", "SuperAdmin", new {
            birim = b,
            statusFilter = sf,
            startDate = Model.StartDateStr,
            endDate = Model.EndDateStr,
            dateSort = Model.DateSort,
            page = 1
        })!;
    }

    // Active filter label
    var activeLabel = Model.StatusFilter switch {
        "active"   => "Aktif",
        "draft"    => "Taslak",
        "passive"  => "Pasif",
        "pending"  => "Onay Bekleyen",
        "rejected" => "Reddedilen",
        _          => null
    };
}

<div class="d-flex justify-content-between align-items-start align-items-sm-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-shield-fill-check me-2" style="color:#7c3aed;"></i>SuperAdmin Paneli</h2>
        <small class="text-muted">Tüm fakültelerin anketlerini görüntüle ve yönet</small>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.PendingApprovalCount > 0)
        {
            <a asp-action="SurveyApprovals" class="btn btn-warning fw-bold">
                <i class="bi bi-clock-history me-1"></i>
                @Model.PendingApprovalCount Onay Bekliyor
            </a>
        }
        else
        {
            <a asp-action="SurveyApprovals" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clock-history me-1"></i>Onay Listesi
            </a>
        }
        <a asp-controller="SuperAdmin" asp-action="CreateSurvey" class="btn fw-bold"
           style="background:#7c3aed;color:#fff;">
            <i class="bi bi-plus-circle me-1"></i>Yeni Anket
        </a>
        <form asp-action="SyncUnitCatalog" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm" title="UnitList ve UnitTypeList önbelleğini API'den yeniler">
                <i class="bi bi-arrow-repeat me-1"></i>Birimleri Senkronize Et
            </button>
        </form>
    </div>
</div>

<!-- İSTATİSTİK KARTLARI (tıklanabilir filtreler) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == null ? "border-sa" : "")">
            <i class="bi bi-clipboard2-data" style="font-size:1.8rem;color:#7c3aed;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.TotalSurveys</h3>
            <p class="text-muted small mb-0">Toplam Anket</p>
            <a href="@CardUrl(null)" class="stretched-link" title="Tümünü Göster"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "active" ? "border-success border-2" : "")">
            <i class="bi bi-check-circle text-success" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.ActiveSurveys</h3>
            <p class="text-muted small mb-0">Aktif</p>
            <a href="@CardUrl("active")" class="stretched-link" title="Aktif Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "draft" ? "border-warning border-2" : "")">
            <i class="bi bi-pencil-square text-warning" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.DraftSurveys</h3>
            <p class="text-muted small mb-0">Taslak</p>
            <a href="@CardUrl("draft")" class="stretched-link" title="Taslak Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "passive" ? "border-secondary border-2" : "")">
            <i class="bi bi-pause-circle text-secondary" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.PassiveSurveys</h3>
            <p class="text-muted small mb-0">Pasif</p>
            <a href="@CardUrl("passive")" class="stretched-link" title="Pasif Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "pending" ? "border-danger border-2" : "")">
            <i class="bi bi-hourglass-split text-danger" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.PendingApprovalCount</h3>
            <p class="text-muted small mb-0">Onay Bekleyen</p>
            <a href="@CardUrl("pending")" class="stretched-link" title="Onay Bekleyen Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3 @(Model.StatusFilter == "rejected" ? "border-secondary border-2" : "")">
            <i class="bi bi-x-circle text-secondary" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.RejectedCount</h3>
            <p class="text-muted small mb-0">Reddedilen</p>
            <a href="@CardUrl("rejected")" class="stretched-link" title="Reddedilen Anketler"></a>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2 col-xl-auto" style="flex:1 1 0;">
        <div class="card stat-card text-center py-3">
            <i class="bi bi-chat-square-text text-info" style="font-size:1.8rem;"></i>
            <h3 class="fw-bold mt-1 mb-0">@Model.TotalResponses</h3>
            <p class="text-muted small mb-0">Yanıt</p>
        </div>
    </div>
</div>

<!-- FİLTRE FORMU -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Dashboard" id="dashFilterForm" class="d-flex gap-2 align-items-center flex-wrap">
            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />

            <!-- Birim filtresi -->
            <label class="fw-semibold mb-0" style="white-space:nowrap;"><i class="bi bi-funnel me-1"></i>Birim:</label>
            <select name="birim" class="form-select form-select-sm" style="min-width:220px;max-width:320px;">
                <option value="">Tüm birimler</option>
                @foreach (var b in Model.AllBirimler)
                {
                    <option value="@b" selected="@(Model.SelectedBirim == b ? "selected" : null)">@b</option>
                }
            </select>

            <!-- Tarih aralığı -->
            <label class="fw-semibold mb-0 ms-1" style="white-space:nowrap;"><i class="bi bi-calendar3 me-1"></i>Tarih:</label>
            <input type="date" name="startDate" class="form-control form-control-sm" style="width:145px;"
                   value="@Model.StartDateStr" placeholder="gg.aa.yyyy" />
            <span class="text-muted mb-0">—</span>
            <input type="date" name="endDate" class="form-control form-control-sm" style="width:145px;"
                   value="@Model.EndDateStr" placeholder="gg.aa.yyyy" />

            <!-- Sıralama -->
            <div class="btn-group btn-group-sm ms-1" role="group" title="Tarih sırası">
                <button type="submit" name="dateSort" value="newest"
                        class="btn @(Model.DateSort != "oldest" ? "btn-secondary" : "btn-outline-secondary")"
                        title="En yeniden → en eskiye">
                    <i class="bi bi-sort-down"></i>
                </button>
                <button type="submit" name="dateSort" value="oldest"
                        class="btn @(Model.DateSort == "oldest" ? "btn-secondary" : "btn-outline-secondary")"
                        title="En eskiden → en yeniye">
                    <i class="bi bi-sort-up"></i>
                </button>
            </div>

            <button type="submit" class="btn btn-sm fw-bold" style="background:#7c3aed;color:#fff;">
                <i class="bi bi-search me-1"></i>Filtrele
            </button>

            @if (!string.IsNullOrEmpty(Model.SelectedBirim) || !string.IsNullOrEmpty(Model.StatusFilter)
                 || !string.IsNullOrEmpty(Model.StartDateStr) || !string.IsNullOrEmpty(Model.EndDateStr))
            {
                <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Temizle
                </a>
            }
        </form>
        @if (!string.IsNullOrEmpty(activeLabel))
        {
            <div class="mt-2">
                <span class="badge text-bg-light border fs-6 fw-normal">
                    <i class="bi bi-filter me-1"></i>@activeLabel filtresi aktif
                </span>
            </div>
        }
    </div>
</div>

<!-- ANKET LİSTESİ -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>Anketler
            @if (!string.IsNullOrEmpty(Model.SelectedBirim))
            {
                <span class="badge ms-2" style="background:#7c3aed !important;">@Model.SelectedBirim</span>
            }
            else
            {
                <span class="badge ms-2 text-bg-light border">Tüm birimler</span>
            }
            @if (!string.IsNullOrEmpty(activeLabel))
            {
                <span class="badge bg-secondary ms-1">@activeLabel</span>
            }
        </h5>
        <span class="text-muted small">
            @Model.TotalCount kayıt
            @if (Model.TotalPages > 1)
            {
                <span> · Sayfa @Model.CurrentPage / @Model.TotalPages</span>
            }
        </span>
    </div>
    <div class="card-body p-0">
        @if (Model.Surveys.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Anket Adı</th>
                            <th>Fakülte / Birim</th>
                            <th>Oluşturan</th>
                            <th>Durum</th>
                            <th>Onay</th>
                            <th>Soru</th>
                            <th>Yanıt</th>
                            <th>Tarih</th>
                            <th class="sa-col-actions text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Surveys)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Title</td>
                                <td>
                                    @{
                                        var isAllBadge = s.TargetUnits.Count > 0
                                            && string.Equals(s.TargetUnits[0], "Tüm birimler",
                                                StringComparison.OrdinalIgnoreCase);
                                    }
                                    @if (isAllBadge || s.TargetUnits.Count >= 20)
                                    {
                                        <span class="badge bg-secondary" style="font-size:.65rem;">Tüm birimler</span>
                                    }
                                    else if (s.TargetUnits.Count > 0)
                                    {
                                        @foreach (var u in s.TargetUnits.Take(3))
                                        {
                                            <span class="badge bg-secondary me-1" style="font-size:.65rem;">@u</span>
                                        }
                                        @if (s.TargetUnits.Count > 3)
                                        {
                                            <span class="text-muted small">+@(s.TargetUnits.Count - 3)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-muted small">@s.CreatedByName</td>
                                <td><span class="badge @s.StatusBadgeClass">@s.Status</span></td>
                                <td>
                                    <span class="badge @s.ApprovalBadgeClass" title="@s.ApprovalNote">
                                        @s.ApprovalLabel
                                    </span>
                                    @if (s.ApprovalStatus == ApprovalStatus.Rejected && !string.IsNullOrEmpty(s.ApprovalNote))
                                    {
                                        <span class="ms-1 text-danger rejection-note-btn"
                                              data-bs-toggle="popover"
                                              data-bs-placement="left"
                                              data-bs-trigger="hover focus"
                                              data-bs-title="Ret Sebebi"
                                              data-bs-content="@s.ApprovalNote"
                                              tabindex="0"
                                              role="button"
                                              title="Ret sebebini gör"
                                              style="cursor:help;">
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                        </span>
                                    }
                                </td>
                                <td>@s.QuestionCount</td>
                                <td>@s.ResponseCount</td>
                                <td class="text-muted small">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="sa-actions-cell">
                                    @{
                                        var fillPath = Url.Action("Fill", "SurveyResponse", new { id = s.Id })!;
                                        var fillAbs = $"{Context.Request.Scheme}://{Context.Request.Host}{fillPath}";
                                    }
                                    <div class="sa-actions-stack">
                                        <div class="sa-toolbar" role="group" aria-label="Anket işlemleri">
                                            <a asp-action="PreviewSurvey" asp-route-id="@s.Id"
                                               class="sa-act sa-act--eye" title="Önizle"><i class="bi bi-eye"></i></a>
                                            <button type="button"
                                                    class="sa-act sa-act--link js-copy-survey-url"
                                                    data-url="@fillAbs"
                                                    title="@(s.IsAnonymous ? "Doldurma adresini kopyala (anonim)" : "Doldurma adresini kopyala — anonim değil, giriş gerekir")">
                                                <i class="bi bi-link-45deg sa-copy-icon" aria-hidden="true"></i>
                                            </button>
                                            <a asp-controller="SuperAdmin" asp-action="EditSurvey" asp-route-id="@s.Id"
                                               class="sa-act sa-act--edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                            <a asp-action="Results" asp-route-id="@s.Id"
                                               class="sa-act sa-act--chart" title="Sonuçlar"><i class="bi bi-bar-chart"></i></a>
                                            @if (s.Status == "Aktif")
                                            {
                                                <form asp-controller="SuperAdmin" asp-action="Close" asp-route-id="@s.Id"
                                                      method="post" class="sa-act-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="sa-act sa-act--stop" title="Kapat"
                                                            onclick="return confirm('Anket kapatılsın mı?');">
                                                        <i class="bi bi-stop-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (s.Status == "Taslak" || s.Status == "Pasif")
                                            {
                                                <form asp-controller="SuperAdmin" asp-action="Publish" asp-route-id="@s.Id"
                                                      method="post" class="sa-act-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="sa-act sa-act--publish" title="Yayınla"
                                                            onclick="return confirm('Anket yayınlansın mı?');">
                                                        <i class="bi bi-broadcast"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (s.Status == "Kapalı")
                                            {
                                                <form asp-controller="SuperAdmin" asp-action="Republish" asp-route-id="@s.Id"
                                                      method="post" class="sa-act-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="sa-act sa-act--publish" title="Tekrar yayınla"
                                                            onclick="return confirm('Anket tekrar yayınlansın mı?');">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="sa-act sa-act--stop-off" title="Bu durumda yayın/kapat yok"><i class="bi bi-stop-circle"></i></span>
                                            }
                                            <form asp-controller="SuperAdmin" asp-action="Delete" asp-route-id="@s.Id"
                                                  method="post" class="sa-act-form"
                                                  onsubmit="return confirm('Bu anket kalıcı olarak silinsin mi?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="sa-act sa-act--trash" title="Sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                        @if (s.ApprovalStatus == ApprovalStatus.Pending)
                                        {
                                            <div class="sa-toolbar-extra">
                                                <a asp-action="SurveyApprovals" class="badge text-bg-warning text-decoration-none">Onay bekliyor</a>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- SAYFALAMA -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-center align-items-center gap-1 py-3">
                    @{
                        var prevDisabled = Model.CurrentPage <= 1 ? "disabled" : "";
                        var nextDisabled = Model.CurrentPage >= Model.TotalPages ? "disabled" : "";
                    }
                    <a class="btn btn-sm btn-outline-secondary @prevDisabled"
                       href="@Url.Action("Dashboard", "SuperAdmin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = Model.CurrentPage - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        var isActive = p == Model.CurrentPage;
                        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 2)
                        {
                            <a class="btn btn-sm @(isActive ? "btn-sa" : "btn-outline-secondary")"
                               href="@Url.Action("Dashboard", "SuperAdmin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = p })">
                                @p
                            </a>
                        }
                        else if (Math.Abs(p - Model.CurrentPage) == 3)
                        {
                            <span class="px-1 text-muted">…</span>
                        }
                    }

                    <a class="btn btn-sm btn-outline-secondary @nextDisabled"
                       href="@Url.Action("Dashboard", "SuperAdmin", new { birim = Model.SelectedBirim, statusFilter = Model.StatusFilter, startDate = Model.StartDateStr, endDate = Model.EndDateStr, dateSort = Model.DateSort, page = Model.CurrentPage + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2">
                    @if (!string.IsNullOrEmpty(activeLabel) || !string.IsNullOrEmpty(Model.SelectedBirim))
                    {
                        @("Seçilen kriterlere uygun anket bulunamadı.")
                    }
                    else
                    {
                        @("Henüz anket yok.")
                    }
                </p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .stat-card {
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
            position: relative;
        }
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,.12) !important;
        }
        .stat-card.border-sa { border: 2px solid #7c3aed !important; }

        /* İşlem sütunu — alt satır (onay) üst satırla binmesin */
        .sa-col-actions,
        .sa-actions-cell {
            width: 1%;
            min-width: 248px;
            white-space: normal;
            vertical-align: middle;
            padding-left: .5rem !important;
            padding-right: .5rem !important;
        }
        .sa-actions-stack {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }
        .sa-toolbar {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            flex-shrink: 0;
            white-space: nowrap;
        }
        .sa-act-form { display: inline-flex; margin: 0; padding: 0; flex-shrink: 0; }
        .sa-act {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 34px;
            height: 34px;
            padding: 0;
            border-radius: 8px;
            border: 2px solid transparent;
            background: #fff;
            text-decoration: none !important;
            font-size: .95rem;
            line-height: 1;
            transition: background .15s, filter .15s, opacity .15s;
        }
        button.sa-act {
            appearance: none;
            cursor: pointer;
            font-family: inherit;
        }
        .sa-act--eye { border-color: #0d6efd; color: #0d6efd; }
        .sa-act--eye:hover { background: rgba(13,110,253,.08); color: #0d6efd; }

        .sa-act--link {
            border-color: #adb5bd;
            color: #6c757d;
        }
        .sa-act--link:hover { background: #f8f9fa; color: #495057; }
        .sa-act--copied {
            border-color: #198754 !important;
            color: #198754 !important;
            background: rgba(25,135,84,.1) !important;
        }
        .sa-act--publish {
            border-color: #198754;
            color: #198754;
            background: rgba(25,135,84,.06);
        }
        .sa-act--publish:hover { filter: brightness(0.97); background: rgba(25,135,84,.14); }

        .sa-act--edit { border-color: #0d6efd; color: #0d6efd; }
        .sa-act--edit:hover { background: rgba(13,110,253,.08); color: #0d6efd; }
        .sa-act--chart { border-color: #0dcaf0; color: #0aa2c0; }
        .sa-act--chart:hover { background: rgba(13,202,240,.12); color: #087990; }
        .sa-act--stop {
            border: none !important;
            background: #ffc107 !important;
            color: #212529 !important;
            cursor: pointer;
        }
        .sa-act--stop:hover { filter: brightness(0.96); }
        .sa-act--stop-off {
            border: 2px dashed #dee2e6 !important;
            background: #f1f3f5 !important;
            color: #adb5bd !important;
            cursor: default;
            pointer-events: none;
        }
        .sa-act--trash { border-color: #dc3545; color: #dc3545; cursor: pointer; }
        .sa-act--trash:hover { background: rgba(220,53,69,.08); color: #dc3545; }
        .sa-toolbar-extra { font-size: .75rem; white-space: normal; }
    </style>
}

@section Scripts {
    <script>
        // Reddedilen anketler için "Ret sebebini gör" popover'ını başlat
        document.querySelectorAll('.rejection-note-btn').forEach(function (el) {
            new bootstrap.Popover(el, { html: false });
        });

        document.body.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-copy-survey-url');
            if (!btn) return;
            e.preventDefault();
            var url = btn.getAttribute('data-url');
            if (!url) return;

            navigator.clipboard.writeText(url).then(function () {
                // İkonu değiştir
                var icon = btn.querySelector('.sa-copy-icon');
                if (icon) {
                    icon.classList.remove('bi-link-45deg');
                    icon.classList.add('bi-check-lg');
                }
                // "Kopyalandı" yazısını göster ve sınıf ekle
                btn.classList.add('sa-act--copied');
                btn.title = 'Panoya kopyalandı!';

                setTimeout(function () {
                    // Geri al
                    if (icon) {
                        icon.classList.remove('bi-check-lg');
                        icon.classList.add('bi-link-45deg');
                    }
                    btn.classList.remove('sa-act--copied');
                    btn.title = btn.getAttribute('data-orig-title') || 'Doldurma adresini kopyala';
                }, 2000);
            }).catch(function () {
                btn.title = 'Kopyalanamadı — adresi elle seçin';
            });
        });
    </script>
}
