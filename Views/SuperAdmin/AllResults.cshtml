@using AnketOtomasyonu.Models.ViewModels
@model SuperAdminResultsViewModel
@{
    ViewData["Title"] = "Tüm Anket Sonuçları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-bar-chart-line me-2" style="color:#7c3aed;"></i>Anket Sonuçları</h2>
        <small class="text-muted">Tüm fakültelerin anket sonuçlarını filtreleyin</small>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
</div>

<!-- FİLTRELER -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="AllResults" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="fw-semibold me-1 mb-0"><i class="bi bi-funnel me-1"></i>Fakülte / Birim:</label>
            <select name="birim" class="form-select form-select-sm" style="max-width:280px;">
                <option value="">— Tüm Fakülteler —</option>
                @foreach (var b in Model.AllBirimler)
                {
                    <option value="@b" selected="@(Model.SelectedBirim == b ? "selected" : null)">@b</option>
                }
            </select>

            <label class="fw-semibold ms-2 mb-0"><i class="bi bi-calendar-range me-1"></i>Tarih:</label>
            <input type="date" name="startDate" class="form-control form-control-sm" style="max-width:150px;"
                   value="@Model.StartDateStr" />
            <span class="text-muted fw-bold">—</span>
            <input type="date" name="endDate" class="form-control form-control-sm" style="max-width:150px;"
                   value="@Model.EndDateStr" />

            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-search me-1"></i>Filtrele
            </button>

            @if (!string.IsNullOrEmpty(Model.SelectedBirim) || !string.IsNullOrEmpty(Model.StartDateStr) || !string.IsNullOrEmpty(Model.EndDateStr))
            {
                <a asp-action="AllResults" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Temizle
                </a>
            }
        </form>
        @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
        {
            <div class="mt-2 small text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Tarih filtresi:
                <strong>@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd.MM.yyyy") : "—")</strong>
                –
                <strong>@(Model.EndDate.HasValue ? Model.EndDate.Value.Date.ToString("dd.MM.yyyy") : "—")</strong>
            </div>
        }
    </div>
</div>

<!-- SONUÇ LİSTESİ -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Yanıt Alan Anketler</h5>
        <span class="text-muted small">@Model.Surveys.Count anket</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Surveys.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="resultsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Anket Adı</th>
                            <th>Fakülte / Birim</th>
                            <th>Oluşturan</th>
                            <th>Durum</th>
                            <th>Yanıt Sayısı</th>
                            <th>Oluşturma Tarihi</th>
                            <th class="text-end">Sonuçlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Surveys.OrderByDescending(x => x.ResponseCount))
                        {
                            <tr>
                                <td class="fw-semibold">@s.Title</td>
                                <td><span class="badge bg-secondary">@s.CreatedByBirim</span></td>
                                <td class="text-muted small">@s.CreatedByName</td>
                                <td><span class="badge @s.StatusBadgeClass">@s.Status</span></td>
                                <td>
                                    <span class="fw-bold" style="color:#7c3aed;">@s.ResponseCount</span>
                                    <span class="text-muted small"> katılımcı</span>
                                </td>
                                <td class="text-muted small">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Results" asp-route-id="@s.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-bar-chart me-1"></i>Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2">
                    @(string.IsNullOrEmpty(Model.SelectedBirim) && string.IsNullOrEmpty(Model.StartDateStr)
                        ? "Henüz yanıt alınmış anket yok."
                        : "Seçilen kriterlere uygun yanıtlı anket bulunamadı.")
                </p>
            </div>
        }
    </div>
</div>

